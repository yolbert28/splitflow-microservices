# .env.example
# Copia este archivo a `.env` (o exporta las variables en tu shell) y rellena
# los valores reales. NUNCA subas `.env` al repositorio.
#
# Cargar antes de arrancar la app:
#   export $(cat .env | xargs)   # o: set -a; source .env; set +a
#   ./mvnw spring-boot:run

# ─── JWT (RS256) — REQUERIDOS ──────────────────────────────────────────────
# La aplicación lanza una excepción al arrancar si no están definidas.
# Son claves PEM en base64 SIN las cabeceras BEGIN/END.
# Generación (RSA 2048):
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private_key.pem
#   openssl pkcs8 -topk8 -in private_key.pem -nocrypt -outform DER | base64 -w0
#   openssl pkey -in private_key.pem -pubout -outform DER | base64 -w0
# La primera es la PRIVADA (PKCS#8 DER), la segunda la PÚBLICA (X.509 DER).
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=

# ─── DataSource (opcional) ─────────────────────────────────────────────────
# Actualmente están fijos en application.properties. Defínelos aquí solo si
# parametrizas application.properties con ${...} para sobrescribirlos.
# DB_URL=jdbc:postgresql://localhost:5432/auth_db
# DB_USERNAME=postgres
# DB_PASSWORD=secret

# ─── RabbitMQ (opcional) ───────────────────────────────────────────────────
# RABBITMQ_HOST=localhost
# RABBITMQ_PORT=5672
# RABBITMQ_USERNAME=myuser
# RABBITMQ_PASSWORD=secret